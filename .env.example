# Umgebungsvariablen (nur Namen, keine Werte; Bedeutung in ARCHITECTURE.md). Echte Werte: Netlify-Konto (Site settings →
# Environment variables) bzw. auf dem Shopify-App-Server. Nie eine .env mit Werten committen.

# Shopify-App-Server (shopify/server/start.mjs)
SHOPIFY_API_SECRET=
PASSFORM_DATEN=
PORT=

# Netlify-Funktionen (netlify/functions/) und lokaler Server (werkzeuge/server.mjs)
PASSFORM_TEAMCODE=
HOSEN_DIR=
HOLEN_LOKAL=
NODE_USE_ENV_PROXY=
HTTPS_PROXY=

# Nur Tests/Werkzeuge
NEUEHOSE_BILDER=
DREH_LOG=
STOFF_LOG=
VERGLEICH_LOG=
